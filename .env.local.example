# Copy this file to .env.local and fill in your own values.
# .env.local is ignored by Git – never commit real keys or passwords.

# Admin dashboard password (required to log in)
ADMIN_PASSWORD=change_me_to_a_strong_password

# Supabase (optional – without it the app runs on in-memory demo data)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Resend (optional – booking confirmation e-mails)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=Surf Wala <bookings@yourdomain.com>
